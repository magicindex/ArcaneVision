[Unit]
Description=Xuanlan (玄览) local file index service
After=network.target local-fs.target

[Service]
Type=simple
User=root
WorkingDirectory=/vol1/@appcenter/xuanlan
Environment=TRIM_PKGVAR=/vol1/@appdata/xuanlan
Environment=TRIM_PKGETC=/vol1/@appconf/xuanlan
Environment=TRIM_APPDEST=/vol1/@appcenter/xuanlan
Environment=TRIM_SERVICE_PORT=8971
ExecStart=/vol1/@appcenter/xuanlan/bin/xuanlan serve --port 8971 --bind 127.0.0.1 --socket /vol1/@appcenter/xuanlan/app.sock --ui /vol1/@appcenter/xuanlan/ui --index-dir /vol1/@appdata/xuanlan/idx --roots /vol1,/vol2,/vol3,/vol4
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=3

[Install]
WantedBy=multi-user.target
