appname                      = xuanlan
version                      = @VERSION@
display_name                 = 玄览
desc                         = """作者：cyberzero

伫中区以玄览，颐情志于典坟。 —— 陆机《文赋》
神念所至，万象玄览
Spiritual Sense, All Things Revealed

飞牛本地文件索引与即时搜索。

直接读取 ext4 元数据建立索引，毫秒级返回任意深度的文件名与路径；索引落盘，重启即用；登录与授权沿用飞牛账号与目录权限，不做第二套。"""
source                       = thirdparty
platform                     = x86
maintainer                   = cyberzero
distributor                  = cyberzero
os_min_version               = 1.0.0
ctl_stop                     = true
desktop_uidir                = ui
desktop_applaunchname        = xuanlan.main
service_port                 = @PORT@
checkport                    = false
disable_authorization_path   = false
changelog                    = """0.8.0 索引 v2（真实 size/mtime 与时间排序）、目录增量子树、HDR/纯音频转码、fail-closed 身份与文件级权限、快照加固。升级后首次启动会自动全量重建。"""
checksum                     = @CHECKSUM@
