appname                      = xuanlan
version                      = @VERSION@
display_name                 = 玄览
desc                         = """作者：cyberzero

神念所至，万象玄览
Spiritual Sense, All Things Revealed

飞牛本地文件索引与即时搜索。

直接读取 ext4 元数据建立索引，毫秒级返回任意深度的文件名与路径；索引落盘，重启即用；登录与授权沿用飞牛账号与目录权限，不做第二套。"""
source                       = thirdparty
platform                     = x86
maintainer                   = cyberzero
distributor                  = cyberzero
os_min_version               = 1.0.0
ctl_stop                     = true
desktop_uidir                = ui
desktop_applaunchname        = xuanlan.main
service_port                 = @PORT@
checkport                    = false
disable_authorization_path   = false
changelog                    = """0.6.1 修复管理员账号无法取消检索范围根目录勾选（此前范围对管理员不生效）、取消父级后子级勾选状态、状态栏显示具体哪个卷不可用。"""
checksum                     = @CHECKSUM@
