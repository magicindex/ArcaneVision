#!/bin/bash
# 玄览 / Arcane Vision — 服务控制（fnOS cmd 入口）
set -u

SELF_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
APP_DIR="${TRIM_APPDEST:-$(dirname -- "${SELF_DIR}")}"
DATA_DIR="${TRIM_PKGVAR:-${APP_DIR}/data}"
ETC_DIR="${TRIM_PKGETC:-${DATA_DIR}/etc}"
PID_FILE="${DATA_DIR}/app.pid"
LOG_FILE="${DATA_DIR}/logs/xuanlan.log"

mkdir -p "${DATA_DIR}/logs" "${DATA_DIR}/idx" "${ETC_DIR}"

log_msg() { echo "$(date '+%F %T') - $*" >> "${LOG_FILE}"; }
check_process() { [ -n "${1:-}" ] && kill -0 "${1}" 2>/dev/null; }

UNIT="xuanlan.service"
UNIT_DST="${XL_UNIT_DST:-/etc/systemd/system/${UNIT}}"
have_systemd() { [ -d /run/systemd/system ]; }

port_value() {
    local p="${TRIM_SERVICE_PORT:-8971}" v
    if [ -r "${ETC_DIR}/service_port" ]; then
        v="$(head -n 1 "${ETC_DIR}/service_port" | tr -d '[:space:]')"
        case "$v" in
            ''|*[!0-9]*) ;;
            *) [ "$v" -ge 1024 ] 2>/dev/null && [ "$v" -le 65535 ] 2>/dev/null && p="$v" ;;
        esac
    fi
    printf '%s' "$p"
}

# 按实际安装位置生成 unit：不再依赖随包写死 /vol1 的 xuanlan.service
ensure_unit() {
    have_systemd || return 1
    local port tmp
    port="$(port_value)"
    tmp="$(mktemp)" || return 1
    cat >"$tmp" <<EOF
[Unit]
Description=Xuanlan (玄览) local file index service
After=network.target local-fs.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=root
WorkingDirectory=${APP_DIR}
Environment=TRIM_PKGVAR=${DATA_DIR}
Environment=TRIM_PKGETC=${ETC_DIR}
Environment=TRIM_APPDEST=${APP_DIR}
Environment=TRIM_SERVICE_PORT=${port}
ExecStart=${APP_DIR}/start.sh
ExecStartPost=/bin/sh -c 'echo \$MAINPID > ${DATA_DIR}/app.pid'
ExecStopPost=/bin/sh -c 'rm -f ${DATA_DIR}/app.pid'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF
    if ! cmp -s "$tmp" "$UNIT_DST" 2>/dev/null; then
        if ! install -m 644 "$tmp" "$UNIT_DST"; then rm -f "$tmp"; return 1; fi
        systemctl daemon-reload >/dev/null 2>&1 || true
    fi
    rm -f "$tmp"
    return 0
}

status() {
    if have_systemd && [ -f "${UNIT_DST}" ]; then
        systemctl is-active --quiet "${UNIT}" && return 0
        return 1
    fi
    [ -r "${PID_FILE}" ] || return 1
    local pid
    pid="$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')"
    if check_process "$pid"; then return 0; fi
    rm -f "${PID_FILE}"
    return 1
}

start_process() {
    if ensure_unit; then
        status || {
            log_msg "systemctl start ${UNIT}"
            systemctl reset-failed "${UNIT}" >/dev/null 2>&1 || true
            systemctl start "${UNIT}" || return 1
        }
        return 0
    fi
    status && return 0
    rm -f "${APP_DIR}/app.sock"
    log_msg "starting via ${APP_DIR}/start.sh"
    cd "${APP_DIR}" || return 1
    setsid "${APP_DIR}/start.sh" >> "${LOG_FILE}" 2>&1 &
    local pid=$!
    printf '%s' "${pid}" > "${PID_FILE}"
    local i
    for i in $(seq 1 40); do
        if [ -S "${APP_DIR}/app.sock" ]; then
            log_msg "started pid=${pid}"
            return 0
        fi
        check_process "$pid" || break
        sleep 0.25
    done
    log_msg "start failed"
    return 1
}

stop_process() {
    log_msg "stopping"
    if have_systemd && [ -f "${UNIT_DST}" ]; then
        systemctl stop "${UNIT}" >/dev/null 2>&1 || true
        rm -f "${PID_FILE}" "${APP_DIR}/app.sock"
        return 0
    fi
    if [ -r "${PID_FILE}" ]; then
        local pid
        pid="$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')"
        if check_process "$pid"; then
            kill -TERM "$pid" 2>/dev/null
            local i
            for i in $(seq 1 20); do
                check_process "$pid" || break
                sleep 0.25
            done
            check_process "$pid" && kill -KILL "$pid" 2>/dev/null
        fi
    fi
    rm -f "${PID_FILE}" "${APP_DIR}/app.sock"
    return 0
}

case "${1:-}" in
    start)   start_process ;;
    stop)    stop_process ;;
    restart) stop_process; start_process ;;
    status)  status && exit 0 || exit 3 ;;
    *)       exit 1 ;;
esac
