#!/bin/bash
# 玄览 / Arcane Vision — 服务控制（fnOS cmd 入口）
set -u

APP_DIR="${TRIM_APPDEST:-/vol1/@appcenter/xuanlan}"
DATA_DIR="${TRIM_PKGVAR:-/vol1/@appdata/xuanlan}"
ETC_DIR="${TRIM_PKGETC:-${DATA_DIR}/etc}"
PID_FILE="${DATA_DIR}/app.pid"
LOG_FILE="${DATA_DIR}/logs/xuanlan.log"

mkdir -p "${DATA_DIR}/logs" "${DATA_DIR}/idx" "${ETC_DIR}"

log_msg() { echo "$(date '+%F %T') - $*" >> "${LOG_FILE}"; }
check_process() { [ -n "${1:-}" ] && kill -0 "${1}" 2>/dev/null; }

UNIT="xuanlan.service"
UNIT_DST="/etc/systemd/system/${UNIT}"
have_systemd() { [ -d /run/systemd/system ]; }

# 把随包安装的 unit 同步到系统（首次安装或升级后）
ensure_unit() {
    have_systemd || return 1
    local src="${APP_DIR}/${UNIT}"
    [ -r "${src}" ] || return 1
    if ! cmp -s "${src}" "${UNIT_DST}" 2>/dev/null; then
        install -m 644 "${src}" "${UNIT_DST}" || return 1
        systemctl daemon-reload >/dev/null 2>&1 || true
    fi
    return 0
}

status() {
    if have_systemd && [ -f "${UNIT_DST}" ]; then
        systemctl is-active --quiet "${UNIT}" && return 0
        return 1
    fi
    [ -r "${PID_FILE}" ] || return 1
    local pid
    pid="$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')"
    if check_process "$pid"; then return 0; fi
    rm -f "${PID_FILE}"
    return 1
}

start_process() {
    if ensure_unit; then
        status || {
            log_msg "systemctl start ${UNIT}"
            systemctl reset-failed "${UNIT}" >/dev/null 2>&1 || true
            systemctl start "${UNIT}" || return 1
        }
        return 0
    fi
    status && return 0
    rm -f "${APP_DIR}/app.sock"
    log_msg "starting via ${APP_DIR}/start.sh"
    cd "${APP_DIR}" || return 1
    setsid "${APP_DIR}/start.sh" >> "${LOG_FILE}" 2>&1 &
    local pid=$!
    printf '%s' "${pid}" > "${PID_FILE}"
    local i
    for i in $(seq 1 40); do
        if [ -S "${APP_DIR}/app.sock" ]; then
            log_msg "started pid=${pid}"
            return 0
        fi
        check_process "$pid" || break
        sleep 0.25
    done
    log_msg "start failed"
    return 1
}

stop_process() {
    log_msg "stopping"
    if have_systemd && [ -f "${UNIT_DST}" ]; then
        systemctl stop "${UNIT}" >/dev/null 2>&1 || true
        rm -f "${PID_FILE}" "${APP_DIR}/app.sock"
        return 0
    fi
    if [ -r "${PID_FILE}" ]; then
        local pid
        pid="$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')"
        if check_process "$pid"; then
            kill -TERM "$pid" 2>/dev/null
            local i
            for i in $(seq 1 20); do
                check_process "$pid" || break
                sleep 0.25
            done
            check_process "$pid" && kill -KILL "$pid" 2>/dev/null
        fi
    fi
    rm -f "${PID_FILE}" "${APP_DIR}/app.sock"
    return 0
}

case "${1:-}" in
    start)   start_process ;;
    stop)    stop_process ;;
    restart) stop_process; start_process ;;
    status)  status && exit 0 || exit 3 ;;
    *)       exit 1 ;;
esac
